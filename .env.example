# Copy to .env and fill in. Every key is optional: with nothing set, NamaSetu runs fully offline
# in MOCK mode with bundled SAMPLE data. .env is git-ignored; never commit real secrets.

# --- App ---
APP_ENV=development                  # development | test | production
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173   # CORS allow-list (comma-separated)
PUBLIC_BASE_URL=http://localhost:8000   # used in FHIR canonical URLs

# --- Database ---
# Docker Compose builds the Postgres URL from these:
POSTGRES_USER=namasetu
POSTGRES_PASSWORD=namasetu
POSTGRES_DB=namasetu
# For local runs without Docker, a sqlite:/// URL switches to LOCAL mode (DB_MODE=sqlite-local):
DATABASE_URL=sqlite:///./data/local.db
# Leave empty to run Celery tasks eagerly in-process (no Redis needed).
REDIS_URL=

# --- WHO ICD-11 API (https://icd.who.int/icdapi) ---
ICD11_MODE=auto                      # auto (LIVE if both keys set) | live | mock
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
ICD11_RELEASE=2025-01                # MMS release id
ICD11_TM_CHAPTER=26                  # traditional-medicine chapter code
ICD11_TM2_TITLE_MATCH=Module 2       # TM2 block located by title inside that chapter (verify against the release)
ICD11_BIOMED_CHAPTERS=15             # comma-separated biomedical chapters to ingest
ICD11_CACHE_DIR=data/cache/icd11     # raw API JSON cache; re-runs work offline
ICD11_MAX_RPS=5
ICD11_MAX_RETRIES=5

# --- ABHA / ABDM gateway ---
ABHA_MODE=mock                       # mock | auto | live
ABHA_CLIENT_ID=
ABHA_CLIENT_SECRET=

# --- Search ---
SEMANTIC_MODE=off                    # full | onnx-int8 | off
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  # multilingual only
# SEMANTIC_ONNX_FILE=onnx/model_qint8_avx512_vnni.onnx   # for onnx-int8
# Full/onnx modes need: pip install -r backend/requirements-semantic.txt && make index

# --- Matching ---
# T_HIGH=0.85                        # override the calibrated confidence gate (unset = calibrated values)
# T_LOW=0.50
STAGE0_GOLD_SPLIT=train              # train | all | none: gold rows used as the official-crosswalk baseline

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string   # REQUIRED in production (startup fails on the default)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Reverse proxy whose X-Forwarded-For uvicorn trusts (rate limits per browser IP). docker-compose pins the
# frontend's nginx to 172.30.0.10; set to your gateway's address in other deployments. Never "*".
FORWARDED_ALLOW_IPS=172.30.0.10
# Demo accounts, one per role. Outside production, unset = documented sandbox defaults
# (Admin@NamaSetu1, Clinician@NamaSetu1, Coder@NamaSetu1, Viewer@NamaSetu1). In production, unset = not created.
DEMO_ADMIN_PASSWORD=
DEMO_CLINICIAN_PASSWORD=
DEMO_CODER_PASSWORD=
DEMO_VIEWER_PASSWORD=
# ABHA_MODE=mock only: OTP that completes the mock ABHA login (clinician demo ABHA address: dr.demo@sbx)
ABHA_MOCK_OTP=123456
